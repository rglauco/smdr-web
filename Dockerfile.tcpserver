# SMDR TCP Server - Dockerfile
FROM python:3.14-slim

WORKDIR /app

COPY requirements.txt .
RUN apt-get update && apt-get install -y --no-install-recommends gosu \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir -r requirements.txt

# Copy only what the TCP server needs
COPY server/ ./server/
COPY database.py ./database.py
COPY docker-entrypoint.sh /docker-entrypoint.sh

RUN mkdir -p /app/data /app/data/reports \
    && groupadd -r smdr && useradd -r -g smdr -d /app -s /sbin/nologin smdr \
    && chown -R smdr:smdr /app \
    && chmod +x /docker-entrypoint.sh

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD python -c "import socket; s=socket.socket(); s.settimeout(2); s.connect(('127.0.0.1',3000)); s.close()" || exit 1

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["python", "-u", "server/tcpsmdrserver.py"]
